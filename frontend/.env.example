# ============================================================
#  PSICOLFIS.NET · FRONTEND · ejemplo de variables de entorno
# ============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# Todas las variables del frontend DEBEN empezar por REACT_APP_
# para que Create React App las exponga al build.
#
# NUNCA subas el `.env` real al repo (el .gitignore lo protege).

# --- URLs base -------------------------------------------------
# En Emergent, la preview URL viene pre-inyectada.
REACT_APP_BACKEND_URL=https://your-deployment.emergentagent.com
# Usada para canonical URLs y og:url. Default: https://psicolfis.net
REACT_APP_PUBLIC_BASE_URL=https://psicolfis.net

# --- Emergent / CRA runtime -----------------------------------
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false

# --- Google Analytics 4 (opcional) ----------------------------
# Deja vacío para no cargar el tag. Formato: G-XXXXXXXXXX
REACT_APP_GA4_ID=

# --- Stripe Payment Links -------------------------------------
# Enlaces "Demo" (50€, one-shot) y "Full" (mensualidad completa).
# Se muestran en los botones "Lo quiero" / "Full" de cada agente.
REACT_APP_STRIPE_DEMO_IRIS=https://buy.stripe.com/...
REACT_APP_STRIPE_DEMO_ALEX=https://buy.stripe.com/...
REACT_APP_STRIPE_DEMO_UMBRAL=https://buy.stripe.com/...
REACT_APP_STRIPE_FULL_IRIS=https://buy.stripe.com/...
REACT_APP_STRIPE_FULL_ALEX=https://buy.stripe.com/...
REACT_APP_STRIPE_FULL_UMBRAL=https://buy.stripe.com/...

# --- CRM incluido en el sector Inmobiliarias ------------------
# URL pública del CRM inmobiliario (por ahora un preview Emergent;
# cuando se despliegue bajo `crm.psicolfis.net`, cambia aquí).
REACT_APP_CRM_DEMO_URL_INMOBILIARIAS=https://git-import-helper.emergent.host/
