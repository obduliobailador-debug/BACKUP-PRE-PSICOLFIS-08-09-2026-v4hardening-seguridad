# ============================================================
#  PSICOLFIS.NET · BACKEND · ejemplo de variables de entorno
# ============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el `.env` real al repositorio. El `.gitignore`
# ya lo protege, pero mejor triple-check antes de un push.

# --- MongoDB ---------------------------------------------------
# En Emergent viene pre-configurado con Mongo local del pod.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="psicolfis"

# --- CORS (producción) -----------------------------------------
# Lista separada por comas. En preview añade la URL de preview.
CORS_ORIGINS="https://psicolfis.net,https://www.psicolfis.net"

# --- Base URL pública ------------------------------------------
# Usada para construir enlaces en emails y JSON-LD.
PUBLIC_BASE_URL="https://psicolfis.net"

# --- Stripe (Live) ---------------------------------------------
# Clave secreta live y secret del webhook (Stripe Dashboard →
# Developers → Webhooks → Signing secret). REQUERIDO para pagos.
STRIPE_API_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# URLs "Full" (upsell desde Demo) — usadas por emails/UI
STRIPE_FULL_URL_IRIS="https://buy.stripe.com/..."
STRIPE_FULL_URL_ALEX="https://buy.stripe.com/..."
STRIPE_FULL_URL_UMBRAL="https://buy.stripe.com/..."

# --- SMTP · Email transaccional --------------------------------
SMTP_SERVER="psicolfis.net"
SMTP_PORT="465"
SMTP_USER="obdulio@psicolfis.net"
SMTP_PASSWORD="<smtp-password>"
SMTP_FROM="obdulio@psicolfis.net"

# --- WhatsApp (redirect oculto) --------------------------------
# Número sin '+' ni espacios. Solo dígitos.
WHATSAPP_NUMBER="34670716305"
WHATSAPP_DEFAULT_TEXT="Hola Obdulio, te escribo desde psicolfis.net"

# --- JWT · Tokens de acceso a los agentes ---------------------
# `JWT_SECRET`: cadena aleatoria de al menos 48 chars. Si rotas
# este secreto, todos los enlaces `/mi-agente/<token>` en circulación
# dejarán de funcionar (es lo esperable en caso de compromiso).
JWT_SECRET="<random 64 chars>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_DAYS="365"

# --- Panel Admin ----------------------------------------------
ADMIN_EMAIL="obdulio@psicolfis.net"
ADMIN_PASSWORD="<admin-password>"
ADMIN_TOKEN_HOURS="8"

# Rate-limit del login (defaults sensatos si se omiten)
LOGIN_LOCK_MAX_ATTEMPTS="5"
LOGIN_LOCK_WINDOW_MIN="15"
# Hops de proxy de confianza para leer X-Forwarded-For (1 en Emergent)
TRUSTED_PROXY_HOPS="1"

# --- Captcha (público) ----------------------------------------
# Si no se define, se genera aleatorio en cada arranque
# (pero eso invalida los captchas activos al reiniciar).
CAPTCHA_SECRET="<random 64 chars>"

# --- Service key interno --------------------------------------
# Solo para /api/access/generate y /api/access/preview-email.
# Rota este valor si sospechas fuga.
SERVICE_API_KEY="<random 64 chars>"

# --- Pickaxe · Deployment IDs de agentes IA -------------------
# IDs de tus agentes en Pickaxe Studio (https://pickaxe.co).
# El nivel "demo" es opcional; si falta, el agente usa el "full".
PICKAXE_DEPLOYMENT_IRIS="<uuid>"
PICKAXE_DEPLOYMENT_ALEX="<uuid>"
PICKAXE_DEPLOYMENT_UMBRAL="<uuid>"
# Variantes limitadas (Demo) — opcionales
PICKAXE_DEPLOYMENT_IRIS_DEMO=""
PICKAXE_DEPLOYMENT_ALEX_DEMO=""
PICKAXE_DEPLOYMENT_UMBRAL_DEMO=""
# Sectores B2B (Inmobiliarias, Dental, Belleza)
PICKAXE_DEPLOYMENT_SECTOR_INMOBILIARIAS=""
PICKAXE_DEPLOYMENT_SECTOR_DENTAL=""
PICKAXE_DEPLOYMENT_SECTOR_BEAUTY=""
